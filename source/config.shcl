## Where this database's files live. A relative path is relative to this file.
## ${HOME} is the one variable expanded.
## gitniblet reads its registry records with absolute paths only, so
## utility/gitniblet-dev.bash turns this file into one and runs gitniblet against it.

name:        "issue-tracker_test"
ddl_path:    "ddl.shcl"
log_dir:     "../gitniblet/issue-tracker_test"
sqlite_path: "${HOME}/.cache/gitniblet/issue-tracker_test/local.sqlite"
